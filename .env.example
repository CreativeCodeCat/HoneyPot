DISCORD_TOKEN=your_discord_bot_token_here

# Optional: Twitch live notifications (/live). Make an app at https://dev.twitch.tv/console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional: the web dashboard. It's off until DISCORD_CLIENT_SECRET is set: copy it from the
# developer portal (OAuth2 > Client Secret), and add DASHBOARD_URL + /callback as a redirect there.
DISCORD_CLIENT_SECRET=
# The application that secret belongs to (OAuth2 > Client ID), if it isn't the bot's own
DISCORD_CLIENT_ID=
# Where people open the dashboard (default http://localhost:8080)
DASHBOARD_URL=
# Where it listens (default 127.0.0.1:8080); use 0.0.0.0:8080 to reach it from other machines
DASHBOARD_ADDR=
